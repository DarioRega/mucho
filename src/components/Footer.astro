---
import client from "../../tina/__generated__/client";

const hoursResponse = await client.queries.openingHours({
  relativePath: "horaires.json"
});
const week = hoursResponse.data.openingHours.week ?? [];

type Period = { closed?: boolean | null; from?: string | null; to?: string | null } | null | undefined;

const formatPeriod = (period: Period) =>
  !period || period.closed || !period.from || !period.to
    ? "Fermé"
    : `${period.from} - ${period.to}`;

const SCHEMA_DAYS = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday"
];

const openingHoursSpecification = week.flatMap((row, index) =>
  [row?.morning, row?.evening]
    .filter((period): period is NonNullable<Period> => !!period && !period.closed && !!period.from && !!period.to)
    .map((period) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: SCHEMA_DAYS[index],
      opens: period.from,
      closes: period.to
    }))
);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BarOrPub",
  name: "Mucho Bar",
  url: "https://muchobar.ch",
  telephone: "+41327250444",
  email: "hello@muchobar.ch",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avenue de la Gare 1",
    postalCode: "2000",
    addressLocality: "Neuchâtel",
    addressCountry: "CH"
  },
  openingHoursSpecification
});

const links = [
  {
    url: "mailto:hello@muchobar.ch",
    name: "hello@muchobar.ch"
  },
  {
    url: "tel:+4132 725 04 44",
    name: "032 725 04 44"
  },
  {
    url: "https://www.instagram.com/mucho_bar/",
    name: "Instagram"
  }
];
---

<footer
  id="contact"
  class="mx-auto grid max-w-xl grid-cols-1 content-center items-center justify-center gap-y-6 lg:max-w-full lg:grid-cols-3 lg:items-start"
>
  <div class="text-center lg:text-left">
    <h3 class="mb-2 text-xl font-medium">
      <strong> MUCHO BAR </strong>
    </h3>
    <div class="text-base font-light md:text-lg">
      <p>Avenue de la Gare 1</p>
      <p>2000 Neuchâtel</p>
    </div>
  </div>
  <div class="text-center">
    <h3 class="mb-2 text-xl font-medium">
      <strong> INFORMATION </strong>
    </h3>
    <div class="grid text-base font-light md:text-lg">
      {
        links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.name}
          </a>
        ))
      }
    </div>
  </div>

  <div class="text-center lg:text-right">
    <h3 class="mb-2 text-xl font-medium">
      <strong> HORAIRES </strong>
    </h3>
    <div class="space-y-1 text-base font-light md:text-lg">
      {
        week.map((row) => (
          <div class="grid grid-cols-5 gap-3">
            <p>{row?.day?.slice(0, 2)}</p>
            <p class="col-span-2">{formatPeriod(row?.morning)}</p>
            <p class="col-span-2">{formatPeriod(row?.evening)}</p>
          </div>
        ))
      }
    </div>
  </div>
</footer>

<script type="application/ld+json" set:html={jsonLd} />
